# Copy to .env and fill in. Nothing here is required for import + analysis.

# Path to a Stockfish binary. Default: ./.stockfish/stockfish, then the one in this checkout, then
# `stockfish` on PATH.
# STOCKFISH_PATH=/usr/bin/stockfish

# Where the SQLite database lives. Default: `db` in ~/.config/chess-coach/config.toml, then
# ./data/chess-coach.db. --db comes before both.
# CHESS_COACH_DB=./data/chess-coach.db

# Lichess personal token: optional, raises the export rate limit. https://lichess.org/account/oauth/token
# LICHESS_TOKEN=lip_...
