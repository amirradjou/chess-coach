# Copy to .env and fill in. Nothing here is required for import + analysis.

# Path to a Stockfish binary. Default: ./.stockfish/stockfish, then `stockfish` on PATH.
# STOCKFISH_PATH=/usr/bin/stockfish

# Where the SQLite database lives. Default: ./data/chess-coach.db
# CHESS_COACH_DB=./data/chess-coach.db

# Lichess personal token: optional, raises the export rate limit. https://lichess.org/account/oauth/token
# LICHESS_TOKEN=lip_...

# Which model narrates digests: claude | ollama | none (deterministic template). Default: none
# LLM_PROVIDER=claude
# ANTHROPIC_API_KEY=sk-ant-...
# OLLAMA_MODEL=qwen2.5:3b
